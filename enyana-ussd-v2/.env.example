# Server
PORT=3000

# Pilot config — determines which flow JSON is loaded (nyakayojo | gulu)
PILOT=nyakayojo

# Twilio WhatsApp credentials — required for live vet alerts
# Leave as-is for local testing: notify.js will skip gracefully
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+256700000000

# Firebase / Firestore — required for farmer registration and returning-farmer lookup
# Option A: path to a downloaded service account JSON file
FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json
# Option B: individual fields from the service account JSON (preferred for cloud deploys)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
