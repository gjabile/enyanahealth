# Server
PORT=3000

# Pilot config — determines which flow JSON is loaded (nyakayojo | gulu)
PILOT=nyakayojo

# Twilio WhatsApp credentials — required for live vet alerts
# Leave as-is for local testing: notify.js will skip gracefully
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+256700000000
